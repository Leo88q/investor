{
  "name": "watchtower-investor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:hub": "node scripts/dev-hub.mjs",
    "build": "vite build && node scripts/seo.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js && node scripts/check-numbers.mjs && node scripts/check-secrets.mjs",
    "test:unit": "node --test tests/*.test.js",
    "test:numbers": "node scripts/check-numbers.mjs",
    "test:secrets": "node scripts/check-secrets.mjs",
    "test:bundle": "node scripts/check-bundle.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.js *.html README.md package.json"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^7.29.9",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "vite": "^8.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
