# Copy to .env.local and never commit it. Every VITE_* value ships in the
# bundle, so nothing secret (no mint key, no read token) belongs here.

# Keep closed until Terms, legal review, contract audit and founder sign-off.
VITE_SALE_OPEN=false
VITE_MARKETPLACE_URL=
VITE_FORM_ENDPOINT=
VITE_CONTACT_URL=
VITE_TERMS_URL=
VITE_SITE_URL=

# Hub API (Games Watchtower). Default is same-origin /api, proxied to the hub
# by the host or CDN so the visitor's browser never calls localhost.
VITE_API_BASE=/api
VITE_API_TIMEOUT_MS=8000

# Consent journal service (interlock i-02). Leave empty to keep the journal in
# the visitor's browser only.
VITE_CONSENT_ENDPOINT=

# Development only: where the dev server proxies /api (scripts/dev-hub.mjs).
DEV_HUB_URL=http://127.0.0.1:5174
